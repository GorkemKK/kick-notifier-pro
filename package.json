{
    "name": "kick-notifier-pro",
    "version": "1.0.6",
    "main": "dist-electron/main.js",
    "description": "Premium Kick Notification App",
    "homepage": "./",
    "build": {
        "appId": "com.kicknotifier.pro",
        "productName": "Kick Notifier Pro",
        "asar": true,
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "public/favicon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "electron/**/*",
            "package.json"
        ],
        "directories": {
            "output": "release"
        }
    },
    "scripts": {
        "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\" \"wait-on tcp:5185 && npm start\"",
        "dev:react": "vite --port 5185",
        "dev:electron": "tsc -w -p tsconfig.electron.json",
        "start": "tsc -p tsconfig.electron.json && set ELECTRON_RUN_AS_NODE=&& .\\node_modules\\electron\\dist\\electron.exe .",
        "build": "tsc -p tsconfig.electron.json && vite build && electron-builder",
        "preview": "vite preview"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "electron-store": "^8.2.0",
        "framer-motion": "^10.18.0",
        "lucide-react": "^0.292.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwind-merge": "^2.6.0"
    },
    "devDependencies": {
        "@types/node": "^25.0.3",
        "@types/react": "^18.2.37",
        "@types/react-dom": "^18.2.15",
        "@vitejs/plugin-react": "^4.2.0",
        "autoprefixer": "^10.4.16",
        "concurrently": "^9.2.1",
        "electron": "^39.2.7",
        "electron-builder": "^24.9.1",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.3.5",
        "typescript": "^5.2.2",
        "vite": "^5.0.0",
        "wait-on": "^9.0.3"
    }
}
